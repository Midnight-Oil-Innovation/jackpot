# Local secrets (per Critical Rule 55 — only operator config files,
# never committed)
config/operator.yaml
config/operator.local.yaml
*.env
*.env.local
!*.env.example
# Per-operator Helm values forks (operators who need more than the
# deploy-workflow's --set overrides can copy values-staging.yaml /
# values-production.yaml as values-*.local.yaml and point their
# workflow at the local copy).
deploy/helm/jackpot-api/values-*.local.yaml

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Nextflow
.nextflow*
work/

# Generated artefacts
node_modules/
.claude/

# E-1: UAT FASTQ fixtures (large public-domain or operator-supplied
# data sourced locally). README and synthetic CSVs in this directory
# are committed; binary sequence data is not.
tests/fixtures/e2e/uat/*.fastq
tests/fixtures/e2e/uat/*.fastq.gz
tests/fixtures/e2e/uat/*.fq
tests/fixtures/e2e/uat/*.fq.gz
tests/fixtures/e2e/uat/*.bam
tests/fixtures/e2e/uat/*.cram
tests/fixtures/e2e/uat/sars-cov-2/

# Tooling artifacts (audit + cleanup outputs)
audit_report*.txt
audit_report*.json
cleanup_plan*.txt
cleanup_report*.txt
cleanup_plan*.json

# Local doc bundle — a concatenation of docs/*.md produced locally.
# Not a source document; the individual files under docs/ are canonical.
docs/docs.md


# Generated analysis / tooling caches - never commit
.ua/
repomix-output.xml
.DS_Store
**/.DS_Store
__pycache__/
*.py[cod]
