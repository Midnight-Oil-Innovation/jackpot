{# Base template — every per-executor template extends this and fills
   the executor_block. Variables expected (StrictUndefined; all must
   be supplied by the renderer):
     run_id                      string
     pipeline_name               string
     pipeline_version            string|None
     pipeline_main_script        string|None
     pipeline_author             string|None
     pipeline_description        string|None
     weblog_url                  string
     result_registration_url     string
     pipeline_token              string
     work_dir                    string  (without trailing /runs/<run_id>/work segment)
     profile.executor_type       upper-case enum string (LOCAL, SLURM, …)
     profile.container_engine    upper-case enum string (DOCKER, …)
     profile.config_overrides    dict (per-executor key set documented per template)
#}
// Generated by JACKPOT POST /api/v1/pipelines/launch (P0g profile renderer)
// Run ID: {{ run_id }} | Pipeline: {{ pipeline_name }} {{ pipeline_version or "" }}
// Profile: {{ profile.name }} ({{ profile.executor_type }} / {{ profile.container_engine }})

manifest {
    name = '{{ pipeline_name }}'
{%- if pipeline_description %}
    description = '{{ pipeline_description }}'
{%- endif %}
{%- if pipeline_author %}
    author = '{{ pipeline_author }}'
{%- endif %}
{%- if pipeline_main_script %}
    mainScript = '{{ pipeline_main_script }}'
{%- endif %}
{%- if pipeline_version %}
    version = '{{ pipeline_version }}'
{%- endif %}
}

plugins {
    id 'nf-validation'
    id 'nf-iridanext'
}

weblog {
    enabled = true
    url = '{{ weblog_url }}'
}

workDir = '{{ work_dir }}/runs/{{ run_id }}/work'

env {
    JACKPOT_RESULT_REGISTRATION_URL = '{{ result_registration_url }}'
    JACKPOT_PIPELINE_TOKEN = '{{ pipeline_token }}'
}

{%- if profile.container_engine == 'DOCKER' %}

docker {
    enabled = true
}

apptainer {
    enabled = false
}

singularity {
    enabled = false
}
{%- elif profile.container_engine == 'APPTAINER' %}

apptainer {
    enabled = true
    autoMounts = true
}

docker {
    enabled = false
}

singularity {
    enabled = false
}
{%- elif profile.container_engine == 'SINGULARITY' %}

singularity {
    enabled = true
    autoMounts = true
}

docker {
    enabled = false
}

apptainer {
    enabled = false
}
{%- endif %}

{%- if profile.executor_type == 'GCP_BATCH' %}

process {
    resourceLabels = [
        'jackpot_run_id': '{{ run_id }}',
        'pipeline_name': '{{ pipeline_name }}',
        'pipeline_version': '{{ pipeline_version or "unspecified" }}'
    ]
}
{%- endif %}

{% block executor_block %}{% endblock %}
