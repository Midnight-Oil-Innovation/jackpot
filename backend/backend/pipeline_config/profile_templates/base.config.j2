{# Base template — every per-executor template extends this and fills
   the executor_block. Variables expected (StrictUndefined; all must
   be supplied by the renderer):
     run_id                      string
     pipeline_name               string
     pipeline_version            string|None
     pipeline_main_script        string|None
     pipeline_author             string|None
     pipeline_description        string|None
     weblog_url                  string
     result_registration_url     string
     pipeline_token              string
     work_dir                    string  (without trailing /runs/<run_id>/work segment)
     profile.executor_type       upper-case enum string (LOCAL, SLURM, …)
     profile.container_engine    upper-case enum string (DOCKER, …)
     profile.config_overrides    dict (per-executor key set documented per template)
#}
// Generated by JACKPOT POST /api/v1/pipelines/launch (P0g profile renderer)
// Run ID: {{ run_id | groovy_escape }} | Pipeline: {{ pipeline_name | groovy_escape }} {{ (pipeline_version or "") | groovy_escape }}
// Profile: {{ profile.name | groovy_escape }} ({{ profile.executor_type }} / {{ profile.container_engine }})

manifest {
    name = '{{ pipeline_name | groovy_escape }}'
{%- if pipeline_description %}
    description = '{{ pipeline_description | groovy_escape }}'
{%- endif %}
{%- if pipeline_author %}
    author = '{{ pipeline_author | groovy_escape }}'
{%- endif %}
{%- if pipeline_main_script %}
    mainScript = '{{ pipeline_main_script | groovy_escape }}'
{%- endif %}
{%- if pipeline_version %}
    version = '{{ pipeline_version | groovy_escape }}'
{%- endif %}
}

plugins {
    id 'nf-validation'
    id 'nf-iridanext'
}

weblog {
    enabled = true
    url = '{{ weblog_url | groovy_escape }}'
}

workDir = '{{ work_dir | groovy_escape }}/runs/{{ run_id | groovy_escape }}/work'

env {
    JACKPOT_RESULT_REGISTRATION_URL = '{{ result_registration_url | groovy_escape }}'
    JACKPOT_PIPELINE_TOKEN = '{{ pipeline_token | groovy_escape }}'
}

{%- if profile.container_engine == 'DOCKER' %}

docker {
    enabled = true
}

apptainer {
    enabled = false
}

singularity {
    enabled = false
}
{%- elif profile.container_engine == 'APPTAINER' %}
{%- set apptainer_cache = profile.config_overrides.get('apptainer_cache_dir') if profile.config_overrides else None %}

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = '{{ (apptainer_cache or (work_dir.rstrip('/') + '/apptainer-cache')) | groovy_escape }}'
}

docker {
    enabled = false
}

singularity {
    enabled = false
}
{%- elif profile.container_engine == 'SINGULARITY' %}

singularity {
    enabled = true
    autoMounts = true
}

docker {
    enabled = false
}

apptainer {
    enabled = false
}
{%- endif %}

{%- if profile.executor_type == 'GCP_BATCH' %}

process {
    resourceLabels = [
        'jackpot_run_id': '{{ run_id | groovy_escape }}',
        'pipeline_name': '{{ pipeline_name | groovy_escape }}',
        'pipeline_version': '{{ (pipeline_version or "unspecified") | groovy_escape }}'
    ]
}
{%- endif %}

{% block executor_block %}{% endblock %}
