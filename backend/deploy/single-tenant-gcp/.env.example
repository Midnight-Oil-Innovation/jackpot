# JACKPOT — Single-tenant GCP deployment with Google Cloud Storage
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

JACKPOT_STORAGE_BACKEND=gcs
JACKPOT_STORAGE_BUCKET_NAME=jackpot-sequences
JACKPOT_STORAGE_GCS_PROJECT=my-gcp-project
JACKPOT_STORAGE_GCS_LOCATION=us-central1
