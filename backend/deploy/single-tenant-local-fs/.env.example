# JACKPOT — Single-tenant local filesystem deployment
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

JACKPOT_STORAGE_BACKEND=local
JACKPOT_STORAGE_LOCAL_ROOT=/var/jackpot/data
JACKPOT_STORAGE_LOCAL_PRESIGN_SECRET=replace-with-32-plus-char-random-string
JACKPOT_STORAGE_LOCAL_PUBLIC_URL_BASE=https://jackpot.lab.example.org/files
