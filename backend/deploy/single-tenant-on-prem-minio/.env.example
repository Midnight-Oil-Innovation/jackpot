# JACKPOT — Single-tenant on-prem deployment with MinIO
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

JACKPOT_STORAGE_BACKEND=minio
JACKPOT_STORAGE_BUCKET_NAME=jackpot-sequences
JACKPOT_STORAGE_S3_ENDPOINT_URL=http://minio.lab.example.org:9000
JACKPOT_STORAGE_S3_ACCESS_KEY=minioadmin
JACKPOT_STORAGE_S3_SECRET_KEY=replace-with-strong-secret
JACKPOT_STORAGE_S3_REGION=us-east-1
JACKPOT_STORAGE_S3_USE_PATH_STYLE=true
