# Generated by `jackpot init configure` for instance 'ci'.
# Scenario: F (CI / e2e test harness)
#
# CRITICAL RULE 56: this file is committed. ZERO secrets, ZERO PII,
# ZERO real operator-specific values. The CI scenario uses synthetic
# defaults baked into the scenario registry; all values here are
# safe-to-publish. See docs/architecture/jackpot-init-cli.md Decision 4.
#
# Operators reproducing CI locally use --instance-name ci-local
# instead of overwriting this file directly.

# ── Compose profile ─────────────────────────────────────────────────
COMPOSE_PROFILES=ci

# ── Backend identity ───────────────────────────────────────────────
ENV=local
HOST_ORGANIZATION_NAME=CI Test Organization
JACKPOT_API_URL=http://localhost:8000

# ── Auth ───────────────────────────────────────────────────────────
MOCK_USER_EMAIL=ci@example.org
GOOGLE_OAUTH_REDIRECT_URL=

# ── Storage ────────────────────────────────────────────────────────
STORAGE_ENDPOINT=
STORAGE_BUCKET_SEQUENCES=jackpot-sequences
STORAGE_BUCKET_RAW=jackpot-raw
STORAGE_BUCKET_STAGING=jackpot-staging
STORAGE_BUCKET_DATASETS=jackpot-datasets
STORAGE_BUCKET_SUBMISSIONS=jackpot-submissions
WORK_BUCKET=jackpot-work
RESULTS_BUCKET=jackpot-results

# ── Pipeline executor ─────────────────────────────────────────────
PIPELINE_EXECUTOR=local

# ── Background jobs + DLP ─────────────────────────────────────────
SCHEDULER_ENABLED=false
DLP_ENABLED=false

# ── CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8501

# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_INGEST=60/minute

# ── Secrets (sourced from instances/<name>/secrets/ at runtime) ───
# SECRET_KEY: see secrets/jwt_signing_key.txt
# GOOGLE_OAUTH_CLIENT_SECRET: see secrets/oauth_client_secret.txt
# NCBI_API_KEY: operator-provided
# JACKPOT_API_TOKEN: operator-provided
