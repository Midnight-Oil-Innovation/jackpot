# Example env vars for a local dev run of the JACKPOT backend pointed at
# staging cloud resources (Cloud SQL, GCS buckets, Secret Manager).
#
# Copy to .env.staging at the repo root, fill in real values, and start
# the API with:
#   uv run uvicorn backend.main:app --env-file .env.staging
#
# DO NOT commit a filled-in version; it contains credentials.

# ── Environment ──────────────────────────────────────────────────────────────
ENV=gcp
SCHEDULER_ENABLED=false
DLP_ENABLED=true

# ── Database ──────────────────────────────────────────────────────────────────
# Use cloud-sql-proxy locally:
#   cloud-sql-proxy <your-gcp-project>:<region>:jackpot-staging-db
# Then point DATABASE_URL at localhost via the proxy.
DATABASE_URL=postgresql://jackpot:CHANGE_ME@127.0.0.1:5432/jackpot_db

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_BYTE_HEX_STRING
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=postmessage

# ── Storage ───────────────────────────────────────────────────────────────────
# GCS bucket names are globally unique across all of Google Cloud. These MUST
# match the buckets your gcs-buckets Terraform module created for this operator.
# Run `terraform output` (or read the module vars) and paste the real names.
STORAGE_BACKEND=gcs
GCP_PROJECT_ID=<your-gcp-project-id>
GCP_REGION=us-central1

STORAGE_BUCKET_SEQUENCES=<your-bucket-prefix>-sequences
STORAGE_BUCKET_RAW=<your-bucket-prefix>-staging
STORAGE_BUCKET_STAGING=<your-bucket-prefix>-staging
STORAGE_BUCKET_DATASETS=<your-bucket-prefix>-references
STORAGE_BUCKET_SUBMISSIONS=<your-bucket-prefix>-portal-exports
WORK_BUCKET=<your-bucket-prefix>-work
RESULTS_BUCKET=<your-bucket-prefix>-results

# ── Pipelines ─────────────────────────────────────────────────────────────────
PIPELINE_EXECUTOR=gcp_batch
JACKPOT_API_URL=https://api.staging.<your-jackpot-domain>

# ── External APIs ─────────────────────────────────────────────────────────────
NCBI_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://staging.<your-jackpot-domain>
