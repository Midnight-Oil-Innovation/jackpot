# Example env vars for a local dev run of jackpot-backend pointed at
# staging cloud resources (Cloud SQL, GCS buckets, Secret Manager).
#
# Copy to jackpot-backend/.env.staging, fill in real values, and start
# the API with:
#   uv run uvicorn backend.main:app --env-file .env.staging
#
# DO NOT commit a filled-in version — it contains credentials.

# ── Environment ──────────────────────────────────────────────────────────────
ENV=gcp
SCHEDULER_ENABLED=false
DLP_ENABLED=true

# ── Database ─────────────────────────────────────────────────────────────────
# Use cloud-sql-proxy locally:
#   cloud-sql-proxy gotero3-acdp-488517:us-central1:jackpot-staging-db
# Then point DATABASE_URL at localhost via the proxy.
DATABASE_URL=postgresql://jackpot:CHANGE_ME@127.0.0.1:5432/jackpot_db

# ── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_BYTE_HEX_STRING
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=postmessage

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_BACKEND=gcs
GCP_PROJECT_ID=gotero3-acdp-488517
GCP_REGION=us-central1

STORAGE_BUCKET_SEQUENCES=jackpot-staging-sequences
STORAGE_BUCKET_RAW=jackpot-staging-staging
STORAGE_BUCKET_STAGING=jackpot-staging-staging
STORAGE_BUCKET_DATASETS=jackpot-staging-references
STORAGE_BUCKET_SUBMISSIONS=jackpot-staging-portal-exports
WORK_BUCKET=jackpot-staging-work
RESULTS_BUCKET=jackpot-staging-results

# ── Pipelines ────────────────────────────────────────────────────────────────
PIPELINE_EXECUTOR=gcp_batch
JACKPOT_API_URL=https://api.staging.jackpot.example.org

# ── External APIs ────────────────────────────────────────────────────────────
NCBI_API_KEY=

# ── Frontend ────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://staging.jackpot.example.org
