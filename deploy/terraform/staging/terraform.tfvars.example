project_id  = "your-gcp-project-id"
region      = "us-central1"
environment = "staging"

# Backups land in a different region for DR
backups_region = "us-east1"

# Rotate after apply via: gcloud sql users set-password jackpot --instance=jackpot-staging-db --password=...
db_password = "CHANGE_ME_BEFORE_APPLY"

# Lock the GKE control-plane endpoint to your office / home / CI CIDRs.
# Empty list = no external access. Populate with the ranges you accept, or
# the deploy pipeline and your own kubectl will both be refused.
master_authorized_networks = [
  # { cidr_block = "203.0.113.0/32", display_name = "operator-home-net" },
  # { cidr_block = "198.51.100.0/24", display_name = "gh-actions-nat" },
]

deletion_protection = true
