      Differences_of_Sex_Development: { description: "DSD" }
      unknown:                        {}

  AgeUnitEnum:
    permissible_values:
      years:  {}
      months: {}
      days:   {}

  BiospecimenTypeEnum:
    permissible_values:
      nasopharyngeal_swab:          {}
