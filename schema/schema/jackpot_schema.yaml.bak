  # ── Cross-sample Association ────────────────────────────────────────────────

  SampleAssociationTypeEnum:
    permissible_values:
      same_household:         { description: "Both samples from same household" }
      same_outbreak:          { description: "Both samples from same outbreak cluster" }
      host_vector:            { description: "Vector sample and its host sample" }
      human_pet:              { description: "Human sample and companion animal sample" }
      food_source_clinical:   { description: "Food sample linked to clinical case" }
      environmental_clinical: { description: "Environmental sample linked to human case" }
      longitudinal:           { description: "Serial samples from the same host over time" }
      other:                  {}

  # ── Sample File Enums ──────────────────────────────────────────────────────

  SampleFileTypeEnum:
    description: "File type for sample_files table. Derived from file extension."
    permissible_values:
      FASTQ:
        description: ".fastq or .fq (with optional .gz or .bz2 compression)"
      FASTA:
        description: ".fasta, .fa, or .fna (with optional .gz compression)"
      OTHER:
        description: "Any file type not covered by FASTQ or FASTA"

  SampleFileLayoutEnum:
    description: >
      Read layout for an individual file in sample_files.
      Distinct from the sample-level library_layout field.
    permissible_values:
      PAIRED:
        description: >
          This file is one of a paired-end pair.
          The partner file is identified by paired_file_id.
      SINGLE:
        description: >
          This file was expected to be part of a pair but no partner
          was found. Treated as unpaired by downstream tools.
      UNPAIRED:
        description: >
          Genuinely single-end read or a nanopore/multi-file chunk.
          Not expected to have a partner.

  ReadDirectionEnum:
    description: "Read direction for paired-end files."
    permissible_values:
      R1:
        description: >
          Forward read. Detected from: _R1, _1, _reads_1, _forward
          naming conventions (case-insensitive).
      R2:
        description: >
          Reverse read. Detected from: _R2, _2, _reads_2, _reverse
          naming conventions (case-insensitive).

