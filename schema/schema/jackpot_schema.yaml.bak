id: https://w3id.org/jackpot/schema
name: jackpot_schema
description: >
  JACKPOT — Pathogen genomics platform for genomic epidemiology,
  bioinformatics, and public health research.

  Schema v4.1 — fully merged. Incorporates:
    - All APGAP spreadsheet field definitions (All_Sequences, human_host,
      wildlife_host, companion_animal, livestock, wastewater, water, air,
      soil, surface, food_products, produce_ag, vectors)
    - ADHS mandatory reportable communicable diseases organism list
    - Coccidioides spp. (Valley fever) by ASU/ADHS request
    - metagenome for metagenomic samples
    - Database-managed sequencing_lab controlled vocabulary design
    - SampleAssociation cross-sample linkage table
    - PipelineProvenance for FAIR R1.2 reusability
    - Full ontology anchoring: GenEpiO, NCBI BioSample, MIxS, PHA4GE,
      NWSS, GA4GH DUO/DRS, LOINC, SNOMED CT, ENVO, OBI, ELR

  Compatible with:
    - DataHarmonizer (PHA4GE templates; runs offline in browser)
    - CDC TOSTADAS (NCBI SRA/BioSample/GenBank submission)
    - GISAID EpiCoV / EpiFlu / EpiPox submission
    - NMDC schema conventions
    - FAIR: JSON-LD serializable via gen-jsonld

version: "4.1"

prefixes:
  linkml:  https://w3id.org/linkml/
  jackpot: https://w3id.org/jackpot/
  genepio: http://purl.obolibrary.org/obo/GENEPIO_
  ncbi:    https://www.ncbi.nlm.nih.gov/biosample/docs/attributes/
  schema:  http://schema.org/
  MIXS:    https://w3id.org/mixs/
  ENVO:    http://purl.obolibrary.org/obo/ENVO_
  OBI:     http://purl.obolibrary.org/obo/OBI_
  DUO:     http://purl.obolibrary.org/obo/DUO_
  LOINC:   http://loinc.org/
  SNOMED:  http://snomed.info/sct/
  GAX:     https://w3id.org/ga4gh/schema/
  NWSS:    https://www.cdc.gov/nwss/

default_prefix: jackpot
default_range: string
imports:
  - linkml:types

# ════════════════════════════════════════════════════════════════════════════
# ORGANIZATIONAL CLASSES  (APGAP-compatible hierarchy)
# ════════════════════════════════════════════════════════════════════════════

classes:

  Organization:
    description: >
      An institution (e.g. ASU, ADHS, CDC). Maps to APGAP Organization model.
    attributes:
      display_name:
        identifier: true
        required: true
      default_approve_analytical_dataset_requests:
        range: boolean
        description: "Auto-approve dataset access requests from this org"

  Lab:
    description: "A research lab or operational unit within an Organization."
    attributes:
      display_name: { identifier: true, required: true }
      organization: { range: Organization, required: true }
      description:  {}

  Project:
    description: "A specific study or surveillance effort within a Lab."
    attributes:
      display_name:   { identifier: true, required: true }
      lab:            { range: Lab, required: true }
      pathogen_scope: { multivalued: true }
      status:         { range: ProjectStatusEnum }

# ════════════════════════════════════════════════════════════════════════════
# BASE SAMPLE CLASS
# Fields from All_Sequences.xlsx plus cross-cutting fields from all other
# sample type spreadsheets.
# ════════════════════════════════════════════════════════════════════════════

  Sample:
    description: >
      Base class for all sequenced samples. Pathogen-agnostic.
      Fields derived from APGAP All_Sequences.xlsx.
      Every URI maps to GenEpiO, NCBI BioSample, MIxS, or OBI where
      a standard term exists.
    attributes:

      # ── Identity ────────────────────────────────────────────────────────
      sample_id:
        slot_uri: ncbi:host_subject_id
        identifier: true
        required: true
        description: >
          Unique alphanumeric identifier for this sample.
          Must not already be in use in the system.
          APGAP: 'Sample ID'. Validation: alphanumeric, unique.
          Portal mints persistent URI at ingest:
          https://data.jackpot.health/samples/{sample_id}

      jackpot_uri:
        description: >
          Persistent URI minted at ingest for FAIR Findability (F1).
          Format: https://data.jackpot.health/samples/{sample_id}
          Stable before NCBI/GISAID accessions are assigned.

      lab:      { required: true }
      project:  { required: true }
      owner:
        description: "Email of the researcher who uploaded the sample"
        required: true

      source_type:
        range: SourceTypeEnum
        required: true
        description: >
          APGAP: 'Source type'. Determines which host-specific subclass
          is required. Further required fields depend on this value.
          Validation: match defined allowable entries.

      # ── Pathogen ────────────────────────────────────────────────────────
      organism_name:
        slot_uri: ncbi:organism
        range: OrganismNameEnum
        required: true
        description: >
          NCBI organism name. Controlled vocabulary derived from the ADHS
          mandatory reportable communicable diseases list, plus Coccidioides
          spp. (Valley fever) and metagenome for metagenomic samples.
          Platform Admins may add new values when novel pathogens emerge.
          Researchers may request additions via the portal.
          Use 'metagenome' when no specific organism is targeted.
          APGAP: 'Pathogen/organism name (or metagenomic)'.

      strain:
        slot_uri: ncbi:strain
        description: >
          Pathogen strain designation.
          Also used for: Influenza subtype (H1N1, H3N2),
          Pango lineage pre-Pangolin-pipeline, rabies variant,
          poliovirus type (wild vs. vaccine-derived).

      isolate:
        slot_uri: ncbi:isolate
        description: >
          APGAP: 'Isolate'. Identification or description of the specific
          individual from which the sample was obtained.

      serotype:
        slot_uri: ncbi:serotype
        description: >
          Serotype of the pathogen isolate.
          Use for: Salmonella serovar (e.g. Typhimurium, Enteritidis),
          Dengue serotype (DENV-1 to DENV-4),
          Poliovirus type (1, 2, 3),
          Influenza subtype (H1N1, H3N2, H5N1).

      # ── NCBI / GISAID Accessions (populated post-submission) ────────────
      biosample_accession:
        description: "NCBI BioSample accession (e.g. SAMN12345678)"
      sra_accession:
        description: "NCBI SRA accession (e.g. SRR12345678)"
      genbank_accession:
        description: "GenBank accession (e.g. OQ123456)"
      gisaid_accession:
        description: "GISAID EPI_ accession (e.g. EPI_ISL_1234567)"
      bioproject_accession:
        description: "NCBI BioProject accession (e.g. PRJNA123456)"

      # ── Experiment and Sequencing ────────────────────────────────────────
      type_of_experiment:
        range: ExperimentTypeEnum
        required: true
        description: >
          APGAP: 'Type of experiment'.
          Validation: match defined allowable entries (one only).

      nucleic_acid_extraction_method:
        multivalued: true
        required: true
        description: >
          APGAP: 'Nucleic acid extraction method'.
          Multiple values permitted. Match defined allowable entries.

      library_preparation_method:
        required: true
        description: >
          APGAP: 'Nucleic acid library preparation method'.
          Match defined allowable entries (one only).

      sequencing_protocol:
        slot_uri: genepio:0001243
        required: true
        description: >
          APGAP: 'Sequencing protocol'. URL to protocol document.
          Validation: URL format preferred
          (e.g. https://www.protocols.io/view/artic-v4-1).

      sequencing_platform:
        slot_uri: genepio:0001239
        range: SequencingPlatformEnum
        required: true
        description: >
          APGAP: 'Sequencing instrument make and model'.
          Validation: match defined allowable entries (one only).

      sequencing_instrument:
        slot_uri: genepio:0001241
        description: >
          Specific instrument model.
          Examples: NextSeq 2000, MinION, Sequel IIe, Ion S5.

      sequencing_lab:
        required: true
        description: >
          APGAP: 'Sequencing lab (originating lab)'. The lab that
          performed the sequencing. NOT a static enum — validated at
          ingest against the sequencing_labs database table, which is
          a Platform Admin-managed controlled vocabulary.
          Seeded values: 'Sonora Quest Laboratories',
          'Laboratory Corporation of America'.
          Registered JACKPOT Labs are auto-added (APGAP backlog #42).
          Unknown values trigger validation error directing Lab Director
          to submit a sequencing lab addition request via the portal
          (APGAP backlog #7).

      date_collected:
        slot_uri: ncbi:collection_date
        range: date
        required: true
        description: >
          APGAP: 'Date Collected'. ISO 8601 format (YYYY-MM-DD).
          Validation: flag if >5 years in past; reject if future date.

      date_sequenced:
        range: date
        required: true
        description: >
          APGAP: 'Date Sequenced'. ISO 8601 format.
          Validation: must not be future date; must not precede
          date_collected.

      collection_facility:
        slot_uri: ncbi:collected_by
        required: true
        description: >
          APGAP: 'Collection facility'. Institution or facility where
          the sample was collected. Match defined allowable entries.

      purpose_for_collection:
        multivalued: true
        required: true
        description: >
          APGAP: 'Purpose for collection and sequencing'.
          Multiple selections permitted. Match defined allowable entries.

      # ── Geography ────────────────────────────────────────────────────────
      collection_location_country:
        slot_uri: genepio:0001181
        required: true
        description: "Country of sample collection"

      collection_location_state:
        slot_uri: genepio:0001182
        description: "US state or equivalent administrative region"

      collection_location_county:
        description: "County or equivalent sub-state region"

      collection_location_zipcode:
        description: >
          APGAP: 'Zip code'. US ZIP code of collection location.
          Validation: 5-digit numeric format.

      geo_lat:
        range: float
        description: "Decimal latitude (WGS84), e.g. 33.4484"

      geo_lon:
        range: float
        description: "Decimal longitude (WGS84), e.g. -112.0740"

      # MMWR epiweek (computed from date_collected at ingest)
      mmwr_year:
        range: integer
        description: "CDC MMWR epiweek year (computed at ingest)"
      mmwr_week:
        range: integer
        description: "CDC MMWR week number 1–53 (computed at ingest)"
      iso_year:
        range: integer
        description: "ISO 8601 week-based year (computed at ingest)"
      iso_week:
        range: integer
        description: "ISO week number 1–53 (computed at ingest)"

      # ── Cross-sample Linkage ──────────────────────────────────────────────
      associated_sample_ids:
        multivalued: true
        description: >
          APGAP: 'IDs of any associated samples'. Present in ALL sample
          type spreadsheets. Links sequences from the same investigation
          (e.g. pet and owner, food product and patient, vector and host).
          Validation: each ID should match an existing sample_id in the
          system. Flag (not reject) if linked sample not yet uploaded —
          may arrive later. Bidirectional linkage confirmed at resolution.
          Stored as directed pairs in the sample_associations table.

      # ── Optional Clinical / Lab Testing ──────────────────────────────────
      ct_value:
        range: float
        description: >
          APGAP: 'Ct value'. PCR cycle threshold value.
          Validation: numeric, range [0, 50].

      other_testing_performed:
        multivalued: true
        description: >
          APGAP: 'Other Testing Performed'. Multiple entries permitted.
          Match defined allowable entries. Flag error if 'none' entered
          alongside any other value.

      lab_of_other_testing:
        multivalued: true
        description: >
          APGAP: 'Lab of Other Testing'. Conditional: required if
          other_testing_performed is not empty or 'none'.

      intermediary_clinical_lab:
        description: >
          APGAP: 'Intermediary clinical lab name'. Optional.
          Match defined allowable entries.

      # ── Sequencing Results (auto-populated post-pipeline) ────────────────
      assembly_method:
        description: "e.g. SPAdes 3.15, IVAR 1.4, Flye 2.9, Unicycler 0.5"

      coverage_depth:
        range: float
        description: "Mean sequencing depth (X)"

      genome_completeness:
        range: float
        description: "Percentage of reference genome covered (0–100)"

      # ── Viral Lineage / Clade (auto-populated by Pangolin + Nextclade) ────
      pango_lineage:
        description: "Pangolin lineage designation, e.g. JN.1, BA.2.86"
      pango_lineage_version:
        description: "Pangolin software version used for assignment"
      nextstrain_clade:
        description: "Nextstrain clade designation, e.g. 24A"
      nextclade_qc_score:
        range: float
        description: "Nextclade QC score (0–100; higher is better quality)"
      nextclade_version:
        description: "Nextclade software version"

      # ── VADR (required before NCBI submission) ────────────────────────────
      vadr_status:
        range: VADRStatusEnum
        description: "NCBI VADR genome annotation validation result"
      vadr_alerts:
        multivalued: true
        description: "VADR alert codes, e.g. CDS_HAS_STOP_CODON"

      # ── AMR (bacterial samples, auto-populated post-pipeline) ────────────
      mlst_scheme:
        description: "MLST scheme, e.g. 'senterica', 'campylobacter'"
      mlst_sequence_type:
        description: "MLST sequence type, e.g. ST131"
      amrfinder_genes:
        multivalued: true
        description: "AMR genes detected by NCBI AMRFinder"
      card_aro_terms:
        multivalued: true
        description: "CARD Antibiotic Resistance Ontology terms detected"

      # ── ELR / Clinical Coding ─────────────────────────────────────────────
      loinc_code:
        slot_uri: LOINC:CODE
        description: >
          LOINC code for the lab test performed.
          e.g. 94500-6 (SARS-CoV-2 RNA, PCR, NP swab)
      loinc_system:
        description: "LOINC specimen/body site, e.g. 'Nasopharynx'"
      snomed_clinical_finding:
        slot_uri: SNOMED:FINDING
        description: "SNOMED CT clinical finding code, e.g. 840539006"

      # ── Submission Status ─────────────────────────────────────────────────
      ncbi_submission_status:
        range: SubmissionStatusEnum
        description: "NCBI SRA/BioSample/GenBank submission status via TOSTADAS"
      ncbi_submitted_at:
        range: datetime
      gisaid_submission_status:
        range: SubmissionStatusEnum
        description: "GISAID EpiCoV/EpiFlu/EpiPox submission status"
      gisaid_submitted_at:
        range: datetime

      # ── File Locations ────────────────────────────────────────────────────
      # fastq_r1_uri and fastq_r2_uri are CONVENIENCE FIELDS for the common
      # 2-file paired-end case. The sample_files table is the canonical
      # per-file registry for ALL cases (multi-lane, nanopore chunks,
      # multiple unpaired reads, mixed extensions, etc.).
      # These fields are populated automatically by the ingest router
      # via file_detector.py → get_convenience_uris().
      fastq_r1_uri:
        required: false
        description: >
          Convenience field: URI of the primary (R1 or first) scrubbed read file.
          Populated automatically for simple 2-file paired runs.
          Supports gs:// (GCS) and drs:// (GA4GH DRS) schemes.
          Accepted extensions: .fastq, .fq, .fasta, .fa, .fna
          with optional .gz or .bz2 compression.
          For all other cases (multi-lane, nanopore, multiple unpaired),
          query the sample_files table for the complete file list.
      fastq_r2_uri:
        description: >
          Convenience field: URI of the R2 FASTQ for simple paired runs.
          NULL for single-end, multi-lane, or nanopore samples.
          Query sample_files for the complete file list.
      raw_fastq_uri:
        description: >
          Pre-scrub URI of primary read file — restricted to Lab Directors
          and above. NULL after 30-day lifecycle deletion.
      consensus_fasta_uri:
        description: "Consensus/assembly FASTA URI (auto-populated post-pipeline)"
      assembly_uri:
        description: "Full assembly FASTA URI (auto-populated post-assembly pipeline)"

      # ── Ingest / Lifecycle ────────────────────────────────────────────────
      scrub_status:    { range: ScrubStatusEnum,   required: true }
      pii_scan_status: { range: PIIScanStatusEnum, required: true }
      ingest_method:   { range: IngestMethodEnum,  required: true }
      sharing_level:   { range: SharingLevelEnum,  required: true }

      # ── Administrative (all optional) ─────────────────────────────────────
      pi_name:
        description: >
          APGAP: 'PI name'. Defaults to Lab Director.
          Validation: must match existing user in the platform.
      grant_number:
        description: "APGAP: 'Grant number'. Alphanumeric."
      contact_other:
        description: >
          APGAP: 'Contact (if other than user uploading data)'.
          Email format. Phase 2: allow non-user contacts.
      comments:
        description: "Free text comments"

# ════════════════════════════════════════════════════════════════════════════
# HOST-SPECIFIC SUBCLASSES — HUMAN AND ANIMAL
# ════════════════════════════════════════════════════════════════════════════

  HumanSample:
    is_a: Sample
    description: >
      Clinical or surveillance sample from a human host.
      Fields from APGAP human_host.xlsx.
      Maps to GA4GH Phenopacket Individual + Disease elements.
    attributes:

      adhs_medsis_id:
        required: true
        description: >
          APGAP: 'ADHS issued ID (links with MEDSIS case data on their end)'.
          Either (1) an anonymized ID linking to the MEDSIS case record, or
          (2) an exemption code obtained for the study if the sample does not
          originate from ADHS surveillance.
          Validation: cross-checked against ADHS-issued ID list when that
          list becomes available. Currently free text — validation to be
          added when ADHS establishes the list.
          Distinct from case_id (used by non-ADHS public health sources).

      case_id:
        description: >
          Generic public health case identifier for non-ADHS sources
          (e.g. CDC NEDSS case ID, county health department ID).

      biospecimen_type:
        range: BiospecimenTypeEnum
        required: true
        description: >
          APGAP: 'Biospecimen type'. Type of biological specimen collected.

      reason_for_collection:
        multivalued: true
        range: ReasonForCollectionEnum
        required: true
        description: >
          APGAP: 'Reason for sample collection'.
          Whether sample was obtained during clinical care or research study.

      host_sex:
        slot_uri: ncbi:host_sex
        range: BiologicalSexEnum
        description: >
          APGAP: 'Sex'. Biological sex of the human host.

      host_age:
        slot_uri: ncbi:host_age
        range: integer
        description: >
          APGAP: 'Age (years)'. Age at time of collection.
          Validation: integer, range [0, 120]. Unit: years.

      host_age_unit:
        range: AgeUnitEnum
        description: "Unit for host_age when age < 1 year"

      host_species:
        slot_uri: ncbi:host
        description: >
          Auto-populated as 'Homo sapiens' for HumanSample. Not user-entered.

      host_disease:
        slot_uri: ncbi:host_disease
        multivalued: true
        required: true
        description: >
          APGAP: 'Disease'. The disease caused by the pathogen (whether or
          not the host is symptomatic). Match defined allowable entries.

      isolation_source:
        slot_uri: ncbi:isolation_source
        description: >
          Auto-populated as 'human clinical specimen' for HumanSample.

      vaccination_status:
        description: >
          e.g. fully vaccinated, unvaccinated, boosted,
          partially vaccinated, unknown.

      clinical_outcome:
        description: >
          e.g. hospitalized, ICU, deceased, outpatient,
          asymptomatic, unknown.

      underlying_conditions:
        multivalued: true
        description: >
          Relevant comorbidities, e.g. diabetes, immunocompromised,
          chronic lung disease, obesity.

  WildlifeSample:
    is_a: Sample
    description: >
      Sample from a wild animal host.
      Fields from APGAP wildlife_host.xlsx.
    attributes:

      host_species:
        slot_uri: ncbi:host
        required: true
        description: >
          APGAP: 'Host species'. Scientific name preferred (genus + species);
          genus only acceptable. Match defined allowable entries.
          Examples: Eptesicus fuscus, Canis latrans, Odocoileus virginianus.

      wildlife_subject_id:
        description: "Optional alphanumeric field identifier for the animal"

      biospecimen_type:
        range: BiospecimenTypeEnum
        required: true

      host_disease:
        slot_uri: ncbi:host_disease
        multivalued: true
        required: true

      isolation_source:
        slot_uri: ncbi:isolation_source
        description: "Auto-derived from host species + biospecimen type"

      isolate:
        slot_uri: ncbi:isolate

  CompanionAnimalSample:
    is_a: Sample
    description: >
      Sample from a companion (pet) animal host.
      Fields from APGAP Companion_animal_host.xlsx.
    attributes:

      host_species:
        slot_uri: ncbi:host
        required: true
        description: >
          APGAP: 'Host species'. Genus and species.
          Examples: felis catus, canis familiaris.

      companion_subject_id:
        description: "Optional alphanumeric field identifier for the animal"

      location_type:
        range: CompanionAnimalLocationEnum
        description: >
          APGAP: 'Location type'. Animal's setting.

      biospecimen_type:
        range: BiospecimenTypeEnum
        required: true

      vaccine_status_against_pathogen:
        range: VaccineStatusEnum
        description: "APGAP: 'Vaccine status against pathogen'"

      host_disease:
        slot_uri: ncbi:host_disease
        multivalued: true
        required: true

      symptomatic:
        range: SymptomaticEnum
        description: "Whether animal was symptomatic at time of collection"

      isolation_source:
        slot_uri: ncbi:isolation_source

      isolate:
        slot_uri: ncbi:isolate

  LivestockSample:
    is_a: Sample
    description: >
      Sample from a livestock or agricultural animal host.
      Fields from APGAP Livestock_Ag_animal_host.xlsx.
    attributes:

      host_species:
        slot_uri: ncbi:host
        required: true
        description: >
          APGAP: 'Host species'. Scientific name of livestock species.
          Examples: Gallus gallus domesticus, Sus domesticus, Lama glama.

      livestock_subject_id:
        description: "Optional field identifier for the individual animal"

      biospecimen_type:
        range: BiospecimenTypeEnum
        required: true

      livestock_products:
        multivalued: true
        range: LivestockProductEnum
        required: true

      location_type:
        range: LivestockLocationEnum

      distribution_scale:
        multivalued: true
        range: DistributionScaleEnum

      antibiotic_use:
        range: AntibioticUseEnum

      host_disease:
        slot_uri: ncbi:host_disease
        multivalued: true
        required: true

      isolation_source:
        slot_uri: ncbi:isolation_source

      isolate:
        slot_uri: ncbi:isolate

  VectorSample:
    is_a: Sample
    description: >
      Sample from a disease vector (arthropod).
      Fields from APGAP vectors.xlsx.
    attributes:

      vector_species:
        required: true
        description: >
          APGAP: 'Vector species'. Scientific name.
          Examples: Aedes aegypti, Culex tarsalis,
          Rhipicephalus sanguineus, Dermacentor andersoni.

      vector_host_species:
        slot_uri: ncbi:host
        description: "Host animal the vector was collected from, if known"

      biospecimen_type:
        range: VectorBiospecimenTypeEnum
        required: true

# ════════════════════════════════════════════════════════════════════════════
# ENVIRONMENTAL SAMPLE SUBCLASSES
# ════════════════════════════════════════════════════════════════════════════

  EnvironmentalSample:
    is_a: Sample
    description: >
      Base class for all environmental samples. Do not instantiate directly —
      use the specific environmental subclasses below.

  WastewaterSample:
    is_a: EnvironmentalSample
    description: >
      Sample from a wastewater collection or treatment system.
      Fields from APGAP wastewater_sample.xlsx, aligned with CDC NWSS
      mandatory reporting fields.
      Reference: https://www.cdc.gov/nwss/reporting.html
    attributes:

      wwtp_name:
        description: >
          APGAP: 'Location (sample_location_specify)'. NWSS: sample_location.
          Wastewater facility name or upstream sewer location.
          Examples: 'South Tempe Water Reclamation Facility',
          'undisclosed sewer line upstream of 5th Ave'.

      sample_location_zipcode:
        description: "US ZIP code of wastewater sampling location (5-digit)"

      county_names:
        multivalued: true
        description: >
          APGAP: 'Service area (county_names)'. NWSS: county_names.
          Counties served by this sampling site, by name or FIPS code.
          System cross-maps name ↔ FIPS. Multiple entries permitted.
          Examples: 'Maricopa County', '04013', 'Coconino'.

      population_served:
        range: integer
        required: true
        description: >
          APGAP/NWSS: 'Population served'. Estimated number of persons
          served by this sampling site. Validation: positive integer.

      sample_type:
        range: WastewaterSampleTypeEnum
        required: true
        description: "APGAP/NWSS: 'Sample type'. e.g. grab, 24-hr composite"

      sample_matrix:
        range: SampleMatrixEnum
        required: true
        description: >
          APGAP/NWSS: 'Sample matrix'. Wastewater matrix from which
          the sample was collected.

      pretreatment:
        multivalued: true
        range: PretreatmentEnum
        required: true
        description: >
          APGAP: 'Pretreatment'. Treatment applied prior to collection.
          Flag if 'none' co-occurs with any other value.

      concentration_method:
        range: ConcentrationMethodEnum
        required: true

      flow_rate_mgd:
        range: float
        required: true
        description: >
          APGAP: 'Flow rate (MGD)'. NWSS: flow_rate.
          Wastewater volumetric flow rate in million gallons per day.
          Validation: positive float. Unit: MGD.

      sample_collect_time:
        range: time
        description: >
          NWSS: 'sample_collect_time'. Local 24-hr time (HH:MM).
          For composite samples: start time.

      pcr_target:
        description: >
          NWSS: 'pcr_target'. PCR quantification target.
          e.g. sars-cov-2, influenza-a, mpox, hMPXV Clade I.
          See NWSS value set vs_pcr_target.

      pcr_gene_target:
        description: >
          NWSS: 'pcr_gene_target'. PCR gene for quantification.
          Must align with pcr_target selection.

      pcr_gene_target_ref:
        description: "NWSS: Publication or URL for the PCR gene target used"

      pcr_type:
        description: >
          NWSS: 'pcr_type'. Type of PCR used.
          Non-sars-cov-2/mpox targets must use a digital PCR type.

      quant_stan_type:
        description: "NWSS: Type of nucleic acid used as quantification standard"

      stan_ref:
        description: "NWSS: Publication/description of quantitative standard"

      lod_ref:
        description: "NWSS: Publication/description of limit of detection method"

      inhibition_method:
        description: "NWSS: Method to evaluate molecular inhibition; 'none' if not tested"

      num_no_target_control:
        range: integer
        description: "NWSS: Number of no-template controls (NTC) per instrument run"

      pasteurized:
        range: boolean
        description: "NWSS: Was the sample pasteurized?"

      env_broad_scale:
        slot_uri: MIXS:env_broad_scale
        description: "MIxS required. ENVO term. e.g. ENVO:00002001 (wastewater)"

      env_local_scale:
        slot_uri: MIXS:env_local_scale
        description: "MIxS required. ENVO term. e.g. ENVO:01000621 (municipal WWTP)"

      env_medium:
        slot_uri: MIXS:env_medium
        description: "MIxS required. ENVO term. e.g. ENVO:00002040 (sewage)"

  WaterSample:
    is_a: EnvironmentalSample
    description: >
      Sample from a non-wastewater water source.
      Fields from APGAP Water_sample.xlsx.
    attributes:

      water_source:
        range: WaterSourceEnum
        description: "APGAP: 'Water source'. Type of water body or supply."

      water_temperature_c:
        range: float
        required: true
        description: >
          APGAP: 'Water temperature (C)'.
          Validation: range [-36, 100]. Unit: °C.

      turbidity_ntu:
        range: float
        required: true
        description: >
          APGAP: 'Turbidity (NTU)'. Nephelometric Turbidity Units.
          Validation: range (0, 4000]; values above 4000 flagged for
          confirmation (possible decimal point omission). Unit: NTU.

      ph:
        range: float
        required: true
        description: "APGAP: 'pH'. Validation: range [0, 14]."

      salinity_ppm:
        range: float
        required: true
        description: "APGAP: 'Salinity (ppm)'. Unit: ppm."

      env_broad_scale:
        slot_uri: MIXS:env_broad_scale
      env_local_scale:
        slot_uri: MIXS:env_local_scale
      env_medium:
        slot_uri: MIXS:env_medium

  AirSample:
    is_a: EnvironmentalSample
    description: >
      Airborne/aerosol sample.
      Fields from APGAP Air.xlsx.
    attributes:

      air_source:
        range: AirSourceEnum
        required: true
        description: >
          APGAP: 'Source'. Origin of the air sample.
          Examples: cooling tower, internal vent, urban, plane.

      airflow_rate_m3_s:
        range: float
        required: true
        description: "APGAP: 'Airflow rate (m³/s)'. Validation: positive float. Unit: m³/s."

      pm25_ug_m3:
        range: float
        required: true
        description: "APGAP: 'PM2.5 (µg/m³)'. Validation: positive float. Unit: µg/m³."

      pm10_ug_m3:
        range: float
        required: true
        description: "APGAP: 'PM10 (µg/m³)'. Validation: positive float. Unit: µg/m³."

      env_broad_scale:
        slot_uri: MIXS:env_broad_scale
      env_local_scale:
        slot_uri: MIXS:env_local_scale
      env_medium:
        slot_uri: MIXS:env_medium

  SoilSample:
    is_a: EnvironmentalSample
    description: >
      Sample from a soil matrix.
      Fields from APGAP Soil_sample.xlsx.
    attributes:

      soil_site_type:
        slot_uri: ncbi:isolation_source
        required: true
        description: >
          APGAP: 'Type of soil site'. Characterization of the soil context.
          Examples: rodent burrow, construction site, agricultural,
          CAFO vicinity.

      sample_depth_cm:
        required: true
        description: >
          APGAP: 'Depth of sample (cm)'. Single value or range.
          Examples: 5, [0, 2], [0, 10].
          Validation: positive numeric, single value or range notation.

      nitrogen_mg_kg:
        range: float
        description: "APGAP: 'Nitrogen (mg/kg)'. Unit: mg/kg."

      soil_temperature_c:
        range: float
        description: >
          APGAP: 'Temperature (C)'. Soil temperature.
          Validation: range [-36, 100]. Unit: °C.

      moisture_g_g:
        range: float
        description: "APGAP: 'Moisture (g/g)'. Gravimetric water content. Unit: g/g."

      organic_carbon_g_kg:
        range: float
        description: "APGAP: 'Organic carbon (g/kg)'. Unit: g/kg."

      soil_ph:
        range: float
        description: "APGAP: 'pH'. Validation: range [0, 14]."

      soil_salinity_ppm:
        range: float
        description: "APGAP: 'Salinity (ppm)'. Unit: ppm."

      env_broad_scale:
        slot_uri: MIXS:env_broad_scale
        description: >
          MIxS required. ENVO term.
          e.g. ENVO:00001998 (soil), ENVO:00000046 (agricultural soil)
      env_local_scale:
        slot_uri: MIXS:env_local_scale
      env_medium:
        slot_uri: MIXS:env_medium

  SurfaceSample:
    is_a: EnvironmentalSample
    description: >
      Surface swab sample (indoor or outdoor).
      Fields from APGAP Surface.xlsx.
      NCBI MIMS.me.built_environment package.
    attributes:

      indoor_space:
        slot_uri: MIXS:indoor_space
        required: true
        description: >
          APGAP/NCBI: 'indoor_space'. Distinguishable space within a structure.
          Allowable: bedroom, office, bathroom, foyer, kitchen, locker room,
          hallway, elevator, missing, not applicable, not collected,
          not provided, restricted access.

      indoor_surface:
        slot_uri: MIXS:indoor_surface
        required: true
        description: >
          APGAP/NCBI: 'indoor_surface'. Type of indoor surface.
          Allowable: counter top, window, wall, cabinet, ceiling, door,
          shelving, vent cover, missing, not applicable, not collected,
          not provided, restricted access.

      indoor_surface_subpart:
        slot_uri: MIXS:indoor_surf_subpart
        description: "APGAP/NCBI: 'indoor_surf_subpart'. Subpart of object swabbed."

      surface_orientation:
        multivalued: true
        description: "APGAP/NCBI: 'surface_orientation'. e.g. underside, top, corner."

      surface_material:
        slot_uri: MIXS:surf_material
        multivalued: true
        required: true
        description: >
          APGAP/NCBI: 'surf_material'. Surface materials at sampling point.
          Examples: concrete, wood, tile, plastic, glass, stainless steel.

      surface_temperature_c:
        slot_uri: MIXS:surf_temp
        range: float
        description: "APGAP/NCBI: 'surf_temp'. Surface temperature. Unit: °C."

      surface_air_contaminants:
        slot_uri: MIXS:surf_air_cont
        multivalued: true
        description: >
          APGAP/NCBI: 'surf_air_cont'. Contaminant on surface.
          Examples: dust, organic matter, particulate matter, VOCs.

      surface_moisture_qualitative:
        slot_uri: MIXS:samp_surf_moisture
        description: >
          APGAP/NCBI: 'samp_surf_moisture'. Qualitative moisture.
          Values: intermittent moisture, not present, submerged.

      surface_moisture_cm3_cm3:
        slot_uri: MIXS:surf_moisture
        range: float
        description: "APGAP/NCBI: 'surf_moisture'. Numeric moisture. Unit: cm³/cm³."

      surface_moisture_ph:
        slot_uri: MIXS:surf_moisture_ph
        range: float
        description: "APGAP/NCBI: 'surf_moisture_ph'. pH of surface moisture. Range [0,14]."

      surface_humidity_pct:
        slot_uri: MIXS:surf_humidity
        range: float
        description: "APGAP/NCBI: 'surf_humidity'. Water activity. Unit: %."

      wall_surface_treatment:
        slot_uri: MIXS:wall_surf_treatment
        multivalued: true
        description: >
          APGAP/NCBI: 'wall_surf_treatment'.
          e.g. painted, wall paper, no treatment, stucco, fabric.

      wall_texture:
        slot_uri: MIXS:wall_texture
        multivalued: true
        description: >
          APGAP/NCBI: 'wall_texture'.
          e.g. smooth, popcorn, orange peel, knockdown, Santa-Fe texture.

      wall_mold_signs:
        slot_uri: MIXS:wall_water_mold
        description: >
          APGAP/NCBI: 'wall_water_mold'. Signs of mold/mildew.
          Values: yes, no, unknown.

      env_broad_scale:
        slot_uri: MIXS:env_broad_scale
        description: "MIxS required. ENVO term. e.g. ENVO:01000162 (built environment)"
      env_local_scale:
        slot_uri: MIXS:env_local_scale
      env_medium:
        slot_uri: MIXS:env_medium

  FoodSample:
    is_a: EnvironmentalSample
    description: >
      Sample from a food product.
      Fields from APGAP Food-Products.xlsx.
    attributes:

      food_location_type:
        range: FoodLocationTypeEnum
        required: true
        description: "APGAP: 'Location type'. Where the food sample was collected."

      storage_temperature_setting:
        description: >
          APGAP: 'Storage temperature setting'. Numeric (°C) or descriptive string.
          Examples: freezer, frozen, refrigerator, shelf, room temperature.
          Validation: numeric OR match defined allowable entries.

      product_temperature_c:
        range: float
        description: >
          APGAP: 'Product temperature (C)'. Actual measured temperature.
          Validation: range [-36, 100]. Unit: °C.

      food_product_type:
        range: FoodProductTypeEnum
        required: true

      env_broad_scale:
        slot_uri: MIXS:env_broad_scale
      env_local_scale:
        slot_uri: MIXS:env_local_scale
      env_medium:
        slot_uri: MIXS:env_medium

  ProduceAgSample:
    is_a: EnvironmentalSample
    description: >
      Sample from an agricultural produce crop.
      Fields from APGAP Produce_Ag.xlsx.
    attributes:

      plant_species:
        required: true
        description: >
          APGAP: 'Plant species'. Scientific name of the agricultural plant.
          Examples: Lactuca sativa var. longifolia, Allium cepa.

      distribution_scale:
        multivalued: true
        range: DistributionScaleEnum

      produce_water_source:
        multivalued: true
        range: ProduceWaterSourceEnum
        required: true

      fertilizer_type:
        multivalued: true
        range: FertilizerTypeEnum

      near_animal_agriculture:
        range: boolean
        required: true
        description: "Whether crop is downwind/downhill of animal ag operations"

      washed_before_packing:
        range: boolean

      env_broad_scale:
        slot_uri: MIXS:env_broad_scale
      env_local_scale:
        slot_uri: MIXS:env_local_scale
      env_medium:
        slot_uri: MIXS:env_medium

# ════════════════════════════════════════════════════════════════════════════
# CROSS-SAMPLE LINKAGE
# ════════════════════════════════════════════════════════════════════════════

  SampleAssociation:
    description: >
      Links two samples from the same investigation.
      Derived from 'IDs of any associated samples' field present in ALL
      APGAP sample type spreadsheets.
      Stored as directed pairs in the sample_associations table.
      Bidirectional: A→B implies B→A but stored as two records.
    attributes:
      source_sample_id: { required: true, identifier: true }
      target_sample_id: { required: true }
      association_type:
        range: SampleAssociationTypeEnum
      notes:
        description: "Free text notes about the association"

# ════════════════════════════════════════════════════════════════════════════
# FAIR PROVENANCE
# ════════════════════════════════════════════════════════════════════════════

  PipelineProvenance:
    description: >
      Structured provenance record for a pipeline run.
      Required for FAIR Reusability (R1.2 — detailed provenance).
      Serialized as JSON-LD alongside pipeline results in GCS.
    attributes:
      pipeline_run_id:  { identifier: true, required: true }
      pipeline_name:    { required: true }
      pipeline_version: {}
      nextflow_version: {}
      reference_databases:
        multivalued: true
        description: >
          Reference databases and versions used.
          e.g. 'Pangolin 4.3/pango-designation 1.2.161',
          'CARD 3.2.9', 'NCBIAMRFinderPlus 2024-01-31.1'
      container_versions:
        multivalued: true
        description: "Docker/Singularity container image URIs with SHA digests"
      input_sample_ids:
        multivalued: true
      output_uris:
        multivalued: true
      completed_at:
        range: datetime

  SampleFile:
    description: >
      A single read file (FASTQ or FASTA) associated with a sample.
      This is the canonical per-file registry and the source of truth
      for all file tracking.

      Replaces the flat fastq_r1_uri / fastq_r2_uri columns on Sample
      as the complete file record. Those columns are kept as convenience
      denormalized fields, populated automatically by file_detector.py
      for the common 2-file paired-end case only.

      Handles all real-world NGS file layouts:
        - Simple paired-end (R1 + R2)
        - Multi-lane Illumina (L001_R1, L001_R2, L002_R1, L002_R2 ...)
        - Nanopore multi-chunk (sample_0.fq.gz, sample_1.fq.gz ...)
        - Single-end / unpaired reads
        - Mixed or non-standard naming

      Supported extensions (case-insensitive):
        .fastq, .fq                  with optional .gz or .bz2
        .fasta, .fa, .fna            with optional .gz
    attributes:
      uri:
        required: true
        identifier: true
        description: >
          gs:// or drs:// URI of the scrubbed file. UNIQUE — the same
          physical file cannot be registered twice.
      raw_uri:
        description: >
          Pre-scrub URI. NULL after raw deletion (30-day lifecycle).
          Accessible to Lab Directors only.
      filename:
        required: true
        description: >
          Original filename as uploaded.
          Examples: covid-19_sample_18_R1.fastq.gz,
          barcode01_0.fq.gz, wgs_L001_R1_001.fastq.gz
      file_size_bytes: { range: integer }
      md5:
        description: "MD5 checksum populated post-upload for integrity verification"
      file_type:
        range: SampleFileTypeEnum
        required: true
        description: "FASTQ / FASTA / OTHER — derived from file extension"
      library_layout:
        range: SampleFileLayoutEnum
        required: true
        description: >
          PAIRED = one of a paired-end pair (partner in paired_file_id).
          SINGLE = paired-end read with missing partner.
          UNPAIRED = genuinely single-end or nanopore chunk.
      read_direction:
        range: ReadDirectionEnum
        description: >
          R1 (forward) or R2 (reverse) for paired reads.
          NULL for unpaired, single-end, or BAM files.
      lane:
        description: >
          Illumina lane identifier, e.g. L001, L002.
          NULL for non-multi-lane runs.
      chunk_index:
        range: integer
        description: >
          Nanopore/multi-file chunk index (0-based).
          NULL for non-chunked data.
      paired_file_id:
        description: >
          ID of the partner SampleFile for this read direction (R1↔R2).
          NULL for unpaired files.
      scrub_status:    { range: ScrubStatusEnum, required: true }
      pii_scan_status: { range: PIIScanStatusEnum, required: true }
      ingest_method:   { range: IngestMethodEnum, required: true }

# ════════════════════════════════════════════════════════════════════════════
# ENUMERATIONS
# ════════════════════════════════════════════════════════════════════════════

enums:

  # ── Organism Names ─────────────────────────────────────────────────────────
  # Source: ADHS mandatory reportable communicable diseases list.
  # Additions: Coccidioides spp. (Valley fever) by ASU/ADHS request;
  #            metagenome per NCBI convention.
  # All names use NCBI Taxonomy format for NCBI submission compatibility.
  # Platform Admins may add new values at runtime via the portal admin UI.

  OrganismNameEnum:
    description: >
      Controlled vocabulary of pathogen organism names.
      Derived from ADHS mandatory reportable communicable diseases.
      Anchored to NCBI Taxonomy for BioSample/SRA/GenBank/GISAID compatibility.

    permissible_values:

      # ── Metagenomic / Unknown ──────────────────────────────────────────────
      metagenome:
        description: >
          Use for metagenomic samples with no specific pathogen targeted
          or identified. NCBI BioSample convention for metagenomics.

      # ── Bacteria (23 species) ─────────────────────────────────────────────
      Bacillus anthracis:
        description: "Anthrax"

      Bordetella pertussis:
        description: "Pertussis (whooping cough)"

      Borrelia hermsii:
        description: "Relapsing fever — tick-borne (Southwest US)"

      Borrelia turicatae:
        description: "Relapsing fever — tick-borne (Southwest US)"

      Brucella abortus:
        description: "Brucellosis — bovine"

      Brucella canis:
        description: "Brucellosis — canine"

      Brucella melitensis:
        description: "Brucellosis — goat/sheep"

      Brucella suis:
        description: "Brucellosis — swine"

      Burkholderia mallei:
        description: "Glanders"

      Burkholderia pseudomallei:
        description: "Melioidosis"

      Clostridium botulinum:
        description: "Botulism"

      Clostridium tetani:
        description: "Tetanus"

      Corynebacterium diphtheriae:
        description: "Diphtheria"

      Coxiella burnetii:
        description: "Q fever"

      Cronobacter sakazakii:
        description: "Cronobacter infection (infant)"

      Escherichia coli:
        description: >
          Shiga toxin-producing E. coli (STEC); hemolytic uremic syndrome.
          Use serotype field for specific serovar (e.g. O157:H7, O111:H8).

      Francisella tularensis:
        description: "Tularemia"

      Haemophilus ducreyi:
        description: "Chancroid"

      Haemophilus influenzae:
        description: "Invasive Haemophilus influenzae disease"

      Leptospira interrogans:
        description: "Leptospirosis"

      Listeria monocytogenes:
        description: "Listeriosis"

      Mycobacterium leprae:
        description: "Hansen's disease (leprosy)"

      Mycobacterium tuberculosis:
        description: "Tuberculosis — active or latent"

      Mycobacterium bovis:
        description: "Tuberculosis — bovine-associated"

      Neisseria gonorrhoeae:
        description: "Gonorrhea"

      Neisseria meningitidis:
        description: "Invasive meningococcal disease"

      Rickettsia prowazekii:
        description: "Epidemic typhus"

      Rickettsia rickettsii:
        description: "Rocky Mountain spotted fever (RMSF)"

      Rickettsia typhi:
        description: "Murine (endemic) typhus"

      Salmonella enterica:
        description: >
          Non-typhoidal Salmonella. Use serotype field for serovar
          (e.g. Typhimurium, Enteritidis, Newport, Heidelberg).

      Salmonella Typhi:
        description: "Typhoid fever (Salmonella enterica serovar Typhi)"

      Staphylococcus aureus:
        description: "Toxic shock syndrome; MRSA — use strain field for MRSA/MSSA"

      Streptococcus pyogenes:
        description: "Streptococcal toxic shock syndrome; Group A Streptococcus"

      Treponema pallidum:
        description: "Syphilis"

      Vibrio cholerae:
        description: "Cholera"

      Yersinia pestis:
        description: "Plague — bubonic, septicemic, or pneumonic"

      # ── Fungi (3 species) ──────────────────────────────────────────────────
      Candida auris:
        description: "Candida auris — multidrug-resistant fungal pathogen"

      Coccidioides immitis:
        description: >
          Valley fever (coccidioidomycosis) — California strain.
          Added by ASU/ADHS request; not on ADHS communicable disease list.

      Coccidioides posadasii:
        description: >
          Valley fever (coccidioidomycosis) — Arizona/Texas strain.
          Predominant species in Arizona.
          Added by ASU/ADHS request; not on ADHS communicable disease list.

      # ── Viruses (25 species/taxa) ──────────────────────────────────────────
      Chikungunya virus:
        description: "Chikungunya fever"

      Crimean-Congo hemorrhagic fever orthonairovirus:
        description: "Crimean-Congo hemorrhagic fever (CCHF)"

      Dengue virus:
        description: >
          Dengue fever. Use serotype field for DENV-1 through DENV-4.

      Ebola virus:
        description: "Ebola virus disease (viral hemorrhagic fever)"

      Hantavirus:
        description: >
          Hantavirus pulmonary syndrome (HPS) — unspecified hantavirus.
          Use Sin Nombre orthohantavirus when species is confirmed.

      Human immunodeficiency virus 1:
        description: "HIV infection; HIV-1"

      Human immunodeficiency virus 2:
        description: "HIV infection; HIV-2"

      Influenza A virus:
        description: >
          Influenza — type A. Use strain field for subtype (H1N1, H3N2, H5N1).

      Influenza B virus:
        description: >
          Influenza — type B. Use strain field for lineage (Victoria, Yamagata).

      Lassa virus:
        description: "Lassa fever (viral hemorrhagic fever)"

      Lymphocytic choriomeningitis virus:
        description: "Lymphocytic choriomeningitis (LCM)"

      Marburg virus:
        description: "Marburg virus disease (viral hemorrhagic fever)"

      Measles virus:
        description: "Measles (rubeola)"

      MERS-CoV:
        description: "Middle East respiratory syndrome coronavirus"

      Mpox virus:
        description: >
          Mpox (formerly monkeypox). Use strain field for clade
          (hMPXV Clade I or hMPXV Clade II).

      Mumps virus:
        description: "Mumps"

      Poliovirus:
        description: >
          Poliomyelitis. Use serotype field for type (1, 2, 3).
          Use strain field for wild vs. vaccine-derived.

      Rabies lyssavirus:
        description: >
          Rabies. Use strain field for variant
          (e.g. bat variant, skunk variant, fox variant).

      Respiratory syncytial virus:
        description: >
          RSV — included under ADHS 'Respiratory disease (outbreak)'.
          Use strain field for RSV-A or RSV-B.

      Rubella virus:
        description: "Rubella (German measles)"

      SARS-CoV:
        description: "Severe acute respiratory syndrome (SARS, 2003)"

      Severe acute respiratory syndrome coronavirus 2:
        description: >
          COVID-19 (novel coronavirus infection). NCBI standard name for SARS-CoV-2.
          Use pango_lineage field for Pangolin lineage designation.

      Sin Nombre orthohantavirus:
        description: "Hantavirus pulmonary syndrome — Sin Nombre virus (Southwest US)"

      St. Louis encephalitis virus:
        description: "St. Louis encephalitis"

      Vaccinia virus:
        description: "Vaccinia-related adverse event (smallpox vaccine)"

      Variola virus:
        description: "Smallpox"

      Varicella-zoster virus:
        description: "Varicella (chickenpox); herpes zoster (shingles)"

      West Nile virus:
        description: "West Nile virus disease"

      Yellow fever virus:
        description: "Yellow fever"

      Zika virus:
        description: "Zika virus infection"

      # ── Parasites (5 species) ──────────────────────────────────────────────
      Naegleria fowleri:
        description: >
          Primary amoebic meningoencephalitis (PAM).
          Free-living protozoan parasite found in warm freshwater.

      Taenia saginata:
        description: "Taeniasis — beef tapeworm"

      Taenia solium:
        description: "Taeniasis and cysticercosis — pork tapeworm"

      Toxoplasma gondii:
        description: "Toxoplasmosis; parasitic encephalitis"

      Trichinella spiralis:
        description: "Trichinosis"

      # ── Novel / Emerging ──────────────────────────────────────────────────
      novel pathogen:
        description: >
          ADHS reportable category: 'Emerging or exotic disease'.
          Use when a novel pathogen is identified but has no stable NCBI
          Taxonomy name yet. Platform Admin assigns permanent name when
          NCBI Taxonomy provides one.

  # ── Source and Experiment Types ────────────────────────────────────────────

  SourceTypeEnum:
    permissible_values:
      Human:          { description: "Clinical or surveillance sample from a human host" }
      Wildlife:       { description: "Sample from a wild animal" }
      CompanionAnimal:{ description: "Sample from a pet or companion animal" }
      Livestock:      { description: "Sample from a farm or agricultural animal" }
      Vector:         { description: "Sample from a disease-transmitting arthropod" }
      Wastewater:     { description: "Sample from a wastewater system" }
      Water:          { description: "Sample from a non-wastewater water source" }
      Air:            { description: "Airborne/aerosol sample" }
      Soil:           { description: "Sample from a soil matrix" }
      Surface:        { description: "Surface swab sample" }
      Food:           { description: "Sample from a food product" }
      ProduceAg:      { description: "Sample from an agricultural crop" }
      Other:          {}

  ExperimentTypeEnum:
    permissible_values:
      WGS:                     { description: "Whole genome sequencing" }
      WES:                     { description: "Whole exome sequencing" }
      RNAseq:                  { description: "RNA sequencing" }
      shotgun_DNA_sequencing:  { description: "Shotgun metagenomic sequencing" }
      amplicon_sequencing:     { description: "Targeted amplicon sequencing (16S, ARTIC, etc.)" }
      targeted_sequencing:     { description: "Other targeted sequencing" }

  # ── Sharing and Access ─────────────────────────────────────────────────────

  SharingLevelEnum:
    permissible_values:
      PRIVATE:
        description: "Owner and Lab Director only"
      LAB:
        description: "All members of the owning Lab"
      DISCOVERABLE:
        description: "Metadata visible to all; files require access request"
      PUBLIC:
        description: "Metadata and files open to all authenticated users"

  # ── Pipeline and Submission Status ────────────────────────────────────────

  ScrubStatusEnum:
    permissible_values:
      PENDING:     {}
      IN_PROGRESS: {}
      COMPLETE:    {}
      FAILED:      {}
      SKIPPED:     { description: "Non-human sample; scrubber not applicable" }

  PIIScanStatusEnum:
    permissible_values:
      PENDING:      {}
      COMPLETE:     {}
      PII_DETECTED: {}
      FAILED:       {}

  VADRStatusEnum:
    permissible_values:
      PASS:    { description: "Passes VADR — eligible for NCBI submission" }
      FAIL:    { description: "Fails VADR — review alerts before submitting" }
      SKIP:    { description: "Not applicable (non-viral or short amplicon)" }
      PENDING: { description: "VADR not yet run" }

  SubmissionStatusEnum:
    permissible_values:
      NOT_SUBMITTED: {}
      PENDING:       {}
      SUBMITTED:     {}
      ACCEPTED:      {}
      FAILED:        {}
      WITHDRAWN:     {}

  IngestMethodEnum:
    permissible_values:
      gui:    {}
      csv:    {}
      rsync:  {}
      curl:   {}
      globus: {}

  ProjectStatusEnum:
    permissible_values:
      ACTIVE:   {}
      ARCHIVED: {}

