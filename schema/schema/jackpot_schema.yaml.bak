      saliva:                       {}
      blood:                        {}
      serum:                        {}
      plasma:                       {}
      urine:                        {}
      stool:                        {}
      skin_biopsy:                  {}
      tissue_biopsy:                {}
      bronchoalveolar_lavage:       {}
      lung_tissue:                  {}
      cloacal_swab:                 { description: "For avian samples" }
      feather:                      {}
      homogenized:                  { description: "For vectors — whole arthropod homogenate" }
      non_destructive_extraction:   { description: "For vectors — saliva/excreta" }
      other:                        {}

  ReasonForCollectionEnum:
    permissible_values:
